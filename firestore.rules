rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 管理員帳號驗證
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "walala@hlbh.hlc.edu.tw";
    }

    // 題庫集合
    match /questionSets/{setId} {
      // 任何人可讀取
      allow read: if true;
      // 只有管理員可以建立、修改、刪除
      allow create, update, delete: if isAdmin();

      // 題目子集合
      match /questions/{qid} {
        allow read: if true;
        allow create, update, delete: if isAdmin();

        // 回覆子集合
        match /responses/{rid} {
          // 任何人可讀取
          allow read: if true;
          // 任何人可以提交回覆（學生作答）
          allow create: if true;
          // 只有管理員可以修改或刪除回覆
          allow update, delete: if isAdmin();
        }
      }
    }

    // 舊版資料相容（如果有的話）
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{qid} {
      allow read: if true;
      allow write: if isAdmin();

      match /responses/{rid} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }
  }
}
